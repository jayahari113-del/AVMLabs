@model AVMLabs.Mvc.Models.ClientListPageVm
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Clients</h2>
    <a asp-controller="Clients" asp-action="Create" class="btn btn-primary">
        + Add New Client
    </a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@Model.SearchTerm"
               class="form-control" placeholder="Search by client name..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    }
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Client Name</th>
                <th>City</th>
                <th>Country</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Clients.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">No clients found.</td>
            </tr>
        }
        else
        {
            @foreach (var client in Model.Clients)
            {
                <tr>
                    <td>@client.ClientName</td>
                    <td>@client.City</td>
                    <td>@client.Country</td>
                    <td class="text-end">
                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@client.ClientId"
                           class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
